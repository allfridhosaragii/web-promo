{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@burupromo/contracts": ["../../packages/contracts/src/index.ts"],
      "@burupromo/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "next.config.ts", "src", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
