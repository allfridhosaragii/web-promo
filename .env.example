# BuruPromo — .env.example (Fase 0, Revisi 2: SEMUA GRATIS Rp0).
# Salin ke .env dan isi sendiri. Jangan commit .env atau file kredensial apa pun.
# Keputusan owner 2026-11-22 (revisi 2): SEMUA Rp0 kecuali domain (owner beli
# sendiri). TIDAK ADA billing account di proyek Google Cloud mana pun.
# LLM: Gemini 2.5 Flash-Lite FREE TIER via Google AI Studio, TANPA billing.
# Budget $5/bulan DIHAPUS — diganti quota guard (jumlah request, ARCH §11.1).
# Hosting produksi: Oracle Cloud Always Free, VM ARM A1 + Caddy (bukan Vercel).
# R2 DIHAPUS — thumbnail di volume lokal VM (STORAGE_PATH).
# X API: budget $0, disabled sampai Fase 2.

APP_NAME=BuruPromo
NODE_ENV=development
TZ=Asia/Jakarta

# --- Domain produksi (satu-satunya biaya, owner beli sendiri) ---
# Kosong = Caddy melayani http://localhost (dev). Produksi: isi domain sendiri.
DOMAIN=

# --- Database (PostgreSQL 16 + PostGIS + pgvector, via docker-compose) ---
DATABASE_URL=postgres://burupromo:burupromo_dev@localhost:5432/burupromo
POSTGRES_USER=burupromo
POSTGRES_PASSWORD=burupromo_dev
POSTGRES_DB=burupromo

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (jangan ekspos master key ke browser) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=change_me_dev_only
MEILISEARCH_INDEX_PROMOS=promos
MEILISEARCH_INDEX_PROMOS_DEV=promos_dev
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- API / Web ---
API_PORT=3001
WEB_PORT=3000
BETTER_AUTH_SECRET=change_me_dev_only
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Penyimpanan file lokal (menggantikan R2, revisi 2) ---
# Thumbnail / bukti screenshot di volume Docker `localdata` (200 GB block
# Oracle Always Free). Opsional: Oracle Object Storage free tier (20 GB).
STORAGE_PATH=/data/localdata

# --- LLM ekstraksi: Gemini FREE TIER, quota guard (BUKAN budget rupiah) ---
# Isi GEMINI_API_KEY hanya saat vertical slice BCA disetujui dijalankan.
# Tanpa key, pipeline TIDAK memanggil API dan memakai ekstraksi aturan +
# antrean review manual. JANGAN hubungkan billing account ke proyek ini.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
# Bacaan terburuk 2.5 Flash-Lite (21 Okt 2026): 10 RPM / 20 RPD. JANGAN isi 1000.
# Cek angka asli di AI Studio proyek owner, lalu sesuaikan di sini + /admin.
LLM_DAILY_REQUESTS=20
LLM_RPM=10

# --- X API: budget $0, DISABLED sampai Fase 2. Jangan isi. ---
X_API_KEY=
X_API_BUDGET_USD=0
X_ENABLED=false

# --- Sinkron Google Spreadsheet (ARCH §17, revisi 2) ---
# Spreadsheet = cermin Postgres, bukan sumber kebenaran. Service account
# (JSON key DI LUAR repo, jangan commit). Share spreadsheet ke email service
# account sebagai Editor. Proyek Google Cloud-nya TANPA billing account.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/secrets/google-service-account.json

# --- Observability gratis (ARCH §3.5.3) ---
# Sentry Developer (free tier): 5.000 error/bulan, 1 user, retensi 30 hari.
# Event di-drop bila habis — tidak ditagih. Sampling rendah, replay MATI.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Umami self-host di VM yang sama (service `umami` di docker-compose).
# Isi setelah buat website di http://localhost:3002 (user admin default: admin/umami).
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
UMAMI_APP_SECRET=change_me_dev_only
